---
import Layout from '@multilaunch/ui/layout';
import queryCMS from '@multilaunch/ui/cms';
import DraftModeQueryListener from '@multilaunch/ui/draft-mode-query-listener';
import getAvailableLocales, { getFallbackLocale } from '@multilaunch/ui/i18n';
import Hero from '@multilaunch/ui/hero';
import Heading from '@multilaunch/ui/heading';
import Line from '@multilaunch/ui/line';
import BrandShowcase from '@multilaunch/ui/brand-showcase';
import ContactForm from '@multilaunch/ui/contact-form';
import ContactFormVertical from '@multilaunch/ui/contact-form-vertical';

import '../../styles/style.css';

export async function getStaticPaths() {
  const availableLocales = await getAvailableLocales();  
  return availableLocales.map(locale => ({
    params: { locale }
  }));
}

const fallbackLocale = await getFallbackLocale();
const { locale } = Astro.params;

const query = `
  query Query($locale: SiteLocale, $fallbackLocale: [SiteLocale!]) {
    layout {
      logo {
        url
        alt
        width
        height
      }
      logoDark {
        url
        alt
        width
        height
      }
    }
    home(locale: $locale, fallbackLocales: $fallbackLocale) {
      _seoMetaTags {
        tag
        attributes
        content
      }
      sections(locale: $locale, fallbackLocales: $fallbackLocale) {
        ... on HeadingRecord {
          id
          _modelApiKey
          index
          label
        }
        ... on HeroSectionRecord {
          id
          _modelApiKey
          heroTitle
          heroSubtitle
          heroImage {
            alt
            url
          }
          ctas {
            label
            url
            variant
          }
        }
        ... on BrandsSectionRecord {
          id
          _modelApiKey
          brands {
            productType
            name
            images {
              url
              alt
              width
              height
            }
            accentColor {
              hex
            }
            slug
          }
        }
        ... on ContactSectionRecord {
          id
          _modelApiKey
          displayOptions
          title
          subtitle
          submitUrl
          submitLabel
          messagePlaceholder
          messageLabel
          logos {
            darkModeImage {
              alt
              url
              width
              height
            }
            lightModeImage {
              alt
              url
              width
              height
            }
          }
          emailPlaceholder
          emailLabel
          companyTitle
          companyLogo {
            darkModeImage {
              alt
              url
              width
              height
            }
            lightModeImage {
              alt
              url
              width
              height
            }
          }
        }
      }     
    }
  }
`;

const { home, layout } = await queryCMS(query, { locale, fallbackLocale });
const pageTitle = 'SEO técnico en Colombia | Auditoría y posicionamiento web';
const pageDescription = 'SEO técnico en Colombia para mejorar rastreo, velocidad, arquitectura y posicionamiento web. Auditorías SEO y estrategia medible.';
const canonicalUrl = new URL(`/${locale}`, Astro.site ?? 'https://seotecnico.co').toString();
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'SEO Técnico',
  description: pageDescription,
  url: canonicalUrl,
  areaServed: ['Colombia', 'Bogotá', 'Medellín'],
  serviceType: ['SEO técnico', 'Auditoría SEO', 'Posicionamiento web', 'SEO local'],
  knowsAbout: ['SEO técnico', 'SEO on-page', 'Core Web Vitals', 'Google Search Console', 'Datos estructurados'],
};
---

<Layout
  additionalSeo={home._seoMetaTags}
  logos={[layout.logo, layout.logoDark]}
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={pageSchema}
>
  {
    home.sections.map((item: any) => {
      switch (item._modelApiKey) {
        case 'heading':
          return (
            <Heading index={item.index} text={item.label} />
            <Line />
          );
        case 'hero_section':
          return <Hero hero={item} />;
        case 'brands_section':
          return <BrandShowcase brands={item} />;
        case 'contact_section': {
          switch (item.displayOptions) {
            case 'vertical_form':
              return <ContactFormVertical form={item} />;
            default:
              return <ContactForm form={item} />;
          }
        }
        default:
          return null;
      }
    })
  }

  <section id="servicios-seo" class="px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <p class="text-xs uppercase mb-3">Servicios de SEO</p>
        <h2 class="text-3xl">Una base técnica sólida para posicionar en Google</h2>
      </div>
      <div class="text-sm leading-7">
        <p>Trabajo la parte técnica y estratégica que sostiene el posicionamiento SEO: diagnóstico, prioridades claras y mejoras que pueden medirse.</p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-8">
      <article class="border border-border p-5">
        <h3 class="text-xl mb-2">Auditoría SEO técnica</h3>
        <p class="text-sm leading-6">Revisión de rastreo, indexación, arquitectura, enlazado interno, etiquetas, errores y oportunidades de crecimiento.</p>
      </article>
      <article class="border border-border p-5">
        <h3 class="text-xl mb-2">SEO on-page y arquitectura web</h3>
        <p class="text-sm leading-6">Organización de URLs, títulos, encabezados, intención de búsqueda y contenidos para que cada página tenga una función.</p>
      </article>
      <article class="border border-border p-5">
        <h3 class="text-xl mb-2">Velocidad y Core Web Vitals</h3>
        <p class="text-sm leading-6">Optimización de imágenes, JavaScript, CSS y experiencia móvil para mejorar rendimiento y conversión.</p>
      </article>
      <article class="border border-border p-5">
        <h3 class="text-xl mb-2">SEO local en Colombia</h3>
        <p class="text-sm leading-6">Estrategia para búsquedas locales, páginas de servicio y señales que ayudan a destacar en Bogotá, Medellín y otras ciudades.</p>
      </article>
    </div>
  </section>

  <section class="px-4 pb-10">
    <h2 class="text-2xl mb-4">Preguntas frecuentes sobre SEO técnico</h2>
    <div class="space-y-4 text-sm leading-6">
      <details class="border-b border-border pb-3">
        <summary class="cursor-pointer font-semibold">¿Qué incluye una auditoría SEO?</summary>
        <p class="pt-2">Incluye el análisis de rastreo, indexación, arquitectura, rendimiento, SEO on-page, enlazado interno y datos estructurados, con prioridades de implementación.</p>
      </details>
      <details class="border-b border-border pb-3">
        <summary class="cursor-pointer font-semibold">¿El SEO técnico mejora el posicionamiento web?</summary>
        <p class="pt-2">Sí. Una web técnicamente accesible permite que Google descubra, interprete y valore mejor sus páginas; debe combinarse con contenido útil y autoridad.</p>
      </details>
    </div>
  </section>

  <DraftModeQueryListener query={query} />
</Layout>