---
import Layout from '@multilaunch/ui/layout';
import queryCMS from '@multilaunch/ui/cms';
import DraftModeQueryListener from '@multilaunch/ui/draft-mode-query-listener';
import getAvailableLocales, { getFallbackLocale } from '@multilaunch/ui/i18n';
import Heading from '@multilaunch/ui/heading';
import Line from '@multilaunch/ui/line';

import '../../styles/style.css';

export async function getStaticPaths() {
  const availableLocales = await getAvailableLocales();  
  return availableLocales.map(locale => ({
    params: { locale }
  }));
}

const fallbackLocale = await getFallbackLocale();
const { locale } = Astro.params;

const query = `
  query {
    layout {
      logo {
        url
        alt
      }
      logoDark {
        url
        alt
      }
    }
  }
`;

const { layout } = await queryCMS(query, { locale, fallbackLocale });
const pageTitle = 'Sobre SEO Técnico | Consultoría SEO en Colombia';
const pageDescription = 'Conoce el enfoque de SEO Técnico para auditoría, arquitectura web, rendimiento y posicionamiento SEO en Colombia.';
const canonicalUrl = new URL(`/${locale}/about`, Astro.site ?? 'https://seotecnico.co').toString();
---

<Layout
  logos={[layout.logo, layout.logoDark]}
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <section>
    <Heading index="01" text="About" />      
    <Line />
    <div class="p-8">
      <h1 class="text-4xl mb-4">SEO técnico para negocios que quieren crecer</h1>
      <p class="text-base leading-7">SEO Técnico combina análisis técnico, arquitectura web y estrategia de contenidos para ayudar a empresas en Colombia a ganar visibilidad orgánica. El trabajo parte de los datos: cómo rastrea Google tu web, qué páginas indexa, qué búsquedas tienen valor y qué mejoras pueden acercarte a más clientes.</p>
      <h2 class="text-2xl mt-10 mb-4">Un enfoque basado en diagnóstico</h2>
      <p class="text-base leading-7">Cada proyecto comienza con una auditoría SEO que revisa rastreo, indexación, enlazado interno, rendimiento, SEO on-page y datos estructurados. Después se ordenan las acciones por impacto, dificultad y relación con los objetivos comerciales.</p>
      <h2 class="text-2xl mt-10 mb-4">SEO técnico, no solo palabras clave</h2>
      <p class="text-base leading-7">Las keywords son una guía, pero el posicionamiento web necesita una arquitectura comprensible, contenidos útiles, experiencia móvil y una base técnica estable. Por eso el trabajo conecta Search Console, analítica, rendimiento y contenido.</p>
      <h2 class="text-2xl mt-10 mb-4">SEO local en Colombia</h2>
      <p class="text-base leading-7">La estrategia puede adaptarse a empresas que buscan clientes en Bogotá, Medellín u otras ciudades de Colombia, con páginas de servicio y señales locales relevantes, sin crear contenido duplicado ni forzar keywords.</p>
    </div>
  </section>      

  <DraftModeQueryListener query={query} />
</Layout>