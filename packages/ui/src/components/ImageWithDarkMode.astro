---
const { images, width, height } = Astro.props ?? {};
const lightImage = images?.lightModeImage || images?.image || images;
const darkImage = images?.darkModeImage;

if (!lightImage?.url) {
  return null;
}
---
<img src={lightImage.url} alt={lightImage.alt || 'Brand logo'} class={`select-none ${ darkImage ? "dark:hidden" : ""}`} width={width} height={height} />

{darkImage && (
  <img src={darkImage.url} alt={darkImage.alt || 'Brand logo'} class="select-none hidden dark:block" width={width} height={height} />
)}